generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

enum TicketStatus {
    OPEN
    IN_PROGRESS
    DONE
}

model Organization {
    id          String       @id @default(cuid())
    name        String
    users       User[]
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt
    memberships Membership[]
}

model Membership {
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String

    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    organizationId String

    joinedAt       DateTime       @default(now())
    isActive       Boolean
    membershipRole MembershipRole @default(MEMBER)

    @@id(name: "membershipId", fields: [userId, organizationId])
    @@index([organizationId])
    @@index([userId])
}

enum MembershipRole {
    MEMBER
    ADMIN
}

// Define user schema
model User {
    id            String  @id @default(cuid())
    username      String  @unique
    email         String  @unique
    emailVerified Boolean @default(false)
    passwordHash  String

    sessions                Session[]
    emailVerificationTokens EmailVerificationToken[]
    passwordResetTokens     PasswordResetToken[]
    tickets                 Ticket[]
    comments                Comment[]
    memberships             Membership[]
    organization            Organization?            @relation(fields: [organizationId], references: [id])
    organizationId          String?
}

// Defining Model Ticket
model Ticket {
    id        String       @id @default(cuid())
    createdAt DateTime     @default(now())
    updatedAt DateTime     @updatedAt
    title     String
    content   String       @db.VarChar(1024)
    status    TicketStatus @default(OPEN)
    bounty    Int          @default(0)
    deadline  String       @default("2025-10-13")
    userId    String
    user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    comments  Comment[]

    @@index([userId])
}

model Session {
    id        String   @id
    expiresAt DateTime
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model EmailVerificationToken {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    code      String
    expiresAt DateTime
    email     String
    userId    String
    user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)

    @@index([userId])
}

model PasswordResetToken {
    id        String   @id @default(cuid())
    token     String   @unique
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    expiresAt DateTime

    @@index([userId])
}

model Comment {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    content   String   @db.VarChar(1024)

    // relation many-to-one with tickets
    ticketId String
    ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

    // relation many-to-one with user
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: SetNull)

    @@index([ticketId])
    @@index([userId])
}
